[node name="Title2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Home/VBoxContainer" unique_id=261977650]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 38
bbcode_enabled = true
