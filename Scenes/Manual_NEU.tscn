[node name="PageTitle" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=2038688491]
layout_mode = 2
bbcode_enabled = true
text = "[b]Energie[/b]"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=1090842675]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=2039417495]
layout_mode = 2
text = "Auf der AstroExplora kann es in seltenen fällen zu einen Energieverlust kommen. Falls dieses unwarscheinliche senario eintrit muss der Sicherungs kasten, hinten im Raum schif bei der in flugrichtung linken Antrieb neu verkabelt werden. Hierfür mussen bestimmte fraben an sokel verbunden werden und nur wen jeder richtig verbunden ist Hat das Schif wieder Energie."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=1374490981]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox/WarningBox" unique_id=1438361782]
layout_mode = 2
text = "ACHTUNG: Niemals zwei gleiche Farben verbinden!"
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=1728408869]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=1813678494]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox/StepList" unique_id=569539212]
layout_mode = 2
text = "1.  Taschenlampe aufheben - Hauptraum neben der Luke."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox/StepList" unique_id=538155865]
layout_mode = 2
text = "2.  Roten Gang - Luke am Ende mit E oeffnen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox/StepList" unique_id=81365175]
layout_mode = 2
text = "3.  Konsole mit E oeffnen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox/StepList" unique_id=954431327]
layout_mode = 2
text = "4.  ROT-ROT, BLAU-BLAU, GELB-GELB, GRUEN-GRUEN verbinden."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox/StepList" unique_id=699017450]
layout_mode = 2
text = "5.  Alle Paare korrekt - Strom kehrt zurueck."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

