[node name="Terra" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=11065724]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Terra"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="TerraText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1405028591]
layout_mode = 2
text = "Ein blau-grüner Planet, wie ihn jedes Kind zeichnen würde: türkisfarbene Ozeane, kleine grüne Landmassen und weisse Wolkenbänder, die über die Oberfläche wirbeln."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator7" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=996568185]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Glacium" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=233473984]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Glacium"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="GlaciumText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1570024302]
layout_mode = 2
text = "Ein kleiner Eisplanet. Blaue und gelbe Adern ziehen sich wie gefrorene Risse über die Oberfläche, als wäre die ganze Welt einmal zersprungen und wieder zusammengefroren."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator8" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1676419327]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Florexia" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=2131579125]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Florexia"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="FlorexiaText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=189474291]
layout_mode = 2
text = "Weniger Planet, mehr kosmische Blume: rosa und hellblaue Blätter legen sich sternförmig um einen leuchtenden Kern. Nicht pflücken."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator9" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1343709414]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Ignara" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1532117150]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Ignara"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="IgnaraText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=79241767]
layout_mode = 2
text = "Ein rotbrauner Gesteinsplanet, übersät mit dunklen, narbigen Kratern. Sein Ringsystem liegt schräg um den Äquator wie ein schlecht sitzender Hut."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator10" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1106431500]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Nyxara" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1681849006]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Nyxara"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="NyxaraText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=347048827]
layout_mode = 2
text = "Ein dunkler Planet, auf dem ein violetter Sturm wirbelt — von weitem wirkt er wie ein riesiges Auge, das zurückstarrt. Die Ränder verlaufen ins Schwarze."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator11" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=147631966]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Stellaris" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1294180615]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Stellaris"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="StellarisText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1473373409]
layout_mode = 2
text = "Kein Planet, sondern eine Raumstation: ein grauer, diamantförmiger Metallkörper, der im Dunkeln glitzert wie eingefrorenes Sternenlicht."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator12" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=697925365]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Pyronis" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=921037807]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Pyronis"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="PyronisText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1104122966]
layout_mode = 2
text = "Ein Gasplanet in Orange, Pink und Violett. Brodelnde Nebelschwaden ziehen über die Oberfläche und verdichten sich zu einem dunklen Kern in der Mitte."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator13" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1633999620]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Solvane" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1083579618]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Solvane"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="SolvaneText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1744699650]
layout_mode = 2
text = "Ein brodelnder Gasriese mit einer einzigen, hypnotischen orangen Spirale, die sich wie ein endloser Sturm um den Kern windet. Nicht zu lange hinsehen."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator14" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=669775474]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Aquaron" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1505587647]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Aquaron"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="AquaronText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=102741919]
layout_mode = 2
text = "Ein blau-oranger Planet mit einem Halbmond auf der Oberfläche — wie eine Welle, die sich ausbreitet, nachdem jemand einen Stein in einen Ozean aus Licht geworfen hat."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator15" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=459673578]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Sproutia" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=223327371]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Sproutia"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="SproutiaText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=314183718]
layout_mode = 2
text = "Ein junger Planet, aus dessen heller Oberfläche zarte grüne Triebe und Ranken wachsen — aufkeimendes Leben mitten in der Leere des Alls. Bitte nicht darauf herumtrampeln."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="HSeparator16" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1732054393]
layout_mode = 2
theme_override_constants/separation = 24
theme_override_styles/separator = SubResource("StyleBoxLine_164it")

[node name="Verdantis" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=776827490]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 28
text = "Verdantis"
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

[node name="VerdantisText" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox/ScrollContainer/VBoxContainer" unique_id=1708965545]
layout_mode = 2
text = "Kein runder Planet, sondern deutlich eiförmig. Die Oberfläche leuchtet in kräftigem Grün. Auffällig sind mehrere violette Lichtbänder, die den Planeten in weiten Schleifen umkreisen und sich vor ihm kreuzen."
fit_content = true
script = ExtResource("2_puywe")
metadata/_custom_type_script = "uid://clg63em8vrbc0"

