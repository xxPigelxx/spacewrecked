[node name="S2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox/StepList" unique_id=1556671819]
layout_mode = 2
text = "2.  Cockpit - rechtes Panel - Schild-Konsole."
fit_content = true
