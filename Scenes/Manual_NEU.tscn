[node name="Rezept" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/ScrollContainer/VBoxContainer/Nyxium" unique_id=1561113157]
layout_mode = 2
text = "Fülle zuerst 20 ml Wasser ein und gib dann 12 ml Xytherium dazu. Hyperion macht 23 ml der Mischung aus, Vortex die restlichen 25 ml. Zeraphine und Oel gehören nicht in dieses Gemisch."
fit_content = true
script = ExtResource("2_puywe")
