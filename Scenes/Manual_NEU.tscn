[node name="VBox" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Zugang" unique_id=924259794]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="PageTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox" unique_id=976832450]
layout_mode = 2
text = "Zugangscodes — Gesperrte Bereiche"

[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox" unique_id=1970629491]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox" unique_id=147938185]
layout_mode = 2
text = "Nach dem Notfall wurden alle Sicherheitstueren verriegelt. Der vierstellige Entsperrcode fuer den Maschinenraum wurde geaendert. Der neue Zugangscode lautet: neun-sechs-zwei-vier. Bei drei Fehleingaben sperrt das System fuer sechzig Sekunden."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox" unique_id=344769409]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox/WarningBox" unique_id=1411595704]
layout_mode = 2
text = "HINWEIS: Code steht im Text oben. Ziffern koennen vertauscht erscheinen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox" unique_id=258376734]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox" unique_id=1541580317]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox/StepList" unique_id=1130094388]
layout_mode = 2
text = "1.  Zum Numpad an der Maschinenraum-Tuer gehen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox/StepList" unique_id=1318511846]
layout_mode = 2
text = "2.  Code aus diesem Tab ablesen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox/StepList" unique_id=948618870]
layout_mode = 2
text = "3.  Code eingeben: 9 - 6 - 2 - 4"
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Zugang/VBox/StepList" unique_id=919492235]
layout_mode = 2
text = "4.  Tuer oeffnet sich automatisch."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

