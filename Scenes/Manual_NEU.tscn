[node name="PageTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox" unique_id=979388773]
layout_mode = 2
text = "Notfall-Handbuch — Bord-KI ASTRO"

[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox" unique_id=532627714]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox" unique_id=1197854936]
layout_mode = 2
text = "Notfall-Protokoll Alpha-7 wurde aktiviert. Das Schiff hat beim Durchflug durch den Asteroidenguertel schwere Schaeden erlitten. Vier Systeme sind ausgefallen. Du musst sie in der richtigen Reihenfolge reparieren. Lies jeden Tab sorgfaeltig."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox" unique_id=168178569]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox/WarningBox" unique_id=696378757]
layout_mode = 2
text = "WARNUNG: Systeme kritisch. Strom zuerst reparieren."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox" unique_id=2146960442]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox" unique_id=402020497]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox/StepList" unique_id=174370588]
layout_mode = 2
text = "1.  Tab STROM oeffnen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox/StepList" unique_id=1503970671]
layout_mode = 2
text = "2.  Sicherungskasten im unteren Deck finden."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox/StepList" unique_id=1226147403]
layout_mode = 2
text = "3.  Kabel verbinden, Tab TREIBSTOFF, dann SCHILD."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox/StepList" unique_id=1170985231]
layout_mode = 2
text = "4.  Zugangscode im Tab ZUGANG ablesen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Uebersicht/VBox/StepList" unique_id=817168854]
layout_mode = 2
text = "5.  Schild aktivieren und starten."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="Strom" type="Control" parent="ManualRoot/PanelContainer/TabContainer" unique_id=880822609]
visible = false
layout_mode = 2
script = ExtResource("3_q6b25")
metadata/_tab_index = 2

[node name="VBox" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Strom" unique_id=1877905917]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="PageTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox" unique_id=1941617404]
layout_mode = 2
text = "Sicherungskasten — Kabelverbindung"

[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox" unique_id=1090842675]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox" unique_id=2039417495]
layout_mode = 2
text = "Der Kurzschluss hat alle Sicherungen ausgeloest. Im unteren Deck hinter der roten Tuer findest du den Hauptsicherungskasten. Verbinde nur gleiche Farben miteinander. Falsche Verbindungen koennen einen Folgebrand ausloesen. Benutze die Taschenlampe."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox" unique_id=1374490981]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox/WarningBox" unique_id=1438361782]
layout_mode = 2
text = "ACHTUNG: Niemals zwei verschiedene Farben verbinden!"
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox" unique_id=1728408869]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox" unique_id=1813678494]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox/StepList" unique_id=569539212]
layout_mode = 2
text = "1.  Taschenlampe aufheben - Hauptraum neben der Luke."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox/StepList" unique_id=538155865]
layout_mode = 2
text = "2.  Roten Gang - Luke am Ende mit E oeffnen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox/StepList" unique_id=81365175]
layout_mode = 2
text = "3.  Konsole mit E oeffnen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox/StepList" unique_id=954431327]
layout_mode = 2
text = "4.  ROT-ROT, BLAU-BLAU, GELB-GELB, GRUEN-GRUEN verbinden."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Strom/VBox/StepList" unique_id=699017450]
layout_mode = 2
text = "5.  Alle Paare korrekt - Strom kehrt zurueck."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="Treibstoff" type="Control" parent="ManualRoot/PanelContainer/TabContainer" unique_id=457657676]
visible = false
layout_mode = 2
script = ExtResource("3_q6b25")
metadata/_tab_index = 3

[node name="VBox" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff" unique_id=1620121749]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="PageTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=2063749577]
layout_mode = 2
text = "Treibstoff-Mischung Typ-B Notverfahren"

[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=672362311]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=939337749]
layout_mode = 2
text = "Das Triebwerk benoetigt fuer den Notstart einen Drei-Komponenten-Mix. Die Reihenfolge ist entscheidend. Lies die Mengen genau ab und bestatige jeden Schritt wenn die Kontrolllampe gruen leuchtet. Niemals Xenon vor Hydrazin einfuellen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=166867886]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/WarningBox" unique_id=1339958454]
layout_mode = 2
text = "KRITISCH: 3x HYDRAZIN - 2x XENON - 1x STABILISATOR TYP-7"
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=7947833]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=976477214]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/StepList" unique_id=923111052]
layout_mode = 2
text = "1.  Cockpit - linkes Panel - Treibstoffkonsole."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/StepList" unique_id=1777775936]
layout_mode = 2
text = "2.  3 Einheiten HYDRAZIN - bestaetigen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/StepList" unique_id=1193335408]
layout_mode = 2
text = "3.  Lampe gruen - 2 Einheiten XENON."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/StepList" unique_id=9377663]
layout_mode = 2
text = "4.  Lampe gruen - 1 Einheit STABILISATOR TYP-7."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/StepList" unique_id=584024462]
layout_mode = 2
text = "5.  Alle gruen - roter Startschalter druecken."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="Zugang" type="Control" parent="ManualRoot/PanelContainer/TabContainer" unique_id=235923854]
visible = false
layout_mode = 2
script = ExtResource("3_q6b25")
