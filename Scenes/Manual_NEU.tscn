[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox" unique_id=804382157]
layout_mode = 2
text = "Das Navigationssystem ist sehr empfindlich. Jedes Mal, wenn das Schiff Schaden nimmt, kann die Navigation ausfallen und muss neu kalibriert werden. Dafür muss eine bestimmte Sequenz von Planeten angesteuert werden. Das ist erst möglich, wenn das Schiff flugtüchtig ist — also genug Energie und den passenden Treibstoff hat. Eine Karte des Alls und eine Beschreibung der Planeten findest du ganz unten auf dieser Seite."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

