[node name="PageTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox" unique_id=1351416326]
layout_mode = 2
text = "Schild-System — Notaktivierung"

[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox" unique_id=1320294761]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox" unique_id=777706702]
layout_mode = 2
text = "Das Schild-System schuetzt vor weiteren Asteroidentreffern. Es kann erst aktiviert werden wenn Strom und Treibstoff repariert sind. Der Kalibrierungscomputer prueft alle vier Sensoren automatisch."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox" unique_id=1536315411]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox/WarningBox" unique_id=486265831]
layout_mode = 2
text = "Schild erst aktivieren wenn Strom UND Treibstoff gruen sind."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox" unique_id=1351086971]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox" unique_id=854526177]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox/StepList" unique_id=427143907]
layout_mode = 2
text = "1.  Strom aktiv? Treibstoff gefuellt? Weiter."
