layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox/WarningBox" unique_id=1635859299]
layout_mode = 2
text = "ACHTUNG:  Die Mischverhältnisse dürfen nur wenig vom Rezept abweichen!"
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

