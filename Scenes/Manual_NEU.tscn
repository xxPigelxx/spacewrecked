[node name="Sep" type="HSeparator" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox" unique_id=538694399]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Navigation/VBox" unique_id=804382157]
layout_mode = 2
text = "Das Navigations System ist shjer fragiel falll je war dem Schiff passier muss es Neu kalibriet werdenn Dafür musss eine bestimmte sequenz von Planeten angestert werden. Dies ist erst möglich wen das Schiff in einem Zustand ist das  es sich auch bewegen kann sprich es muss Energie haben und auch den passenden triebstoff. Zuerst muss der Planet \"Thsien\" angesteuert werden."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

