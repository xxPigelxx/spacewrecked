[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Energie/VBox" unique_id=2039417495]
layout_mode = 2
text = "Auf der AstroExplora kann es in seltenen Fällen zu einem Energieverlust kommen. Tritt dieses unwahrscheinliche Szenario ein, muss der Sicherungskasten neu verkabelt werden. Er befindet sich hinten im Schiff, am in Flugrichtung linken Antrieb. Dabei müssen bestimmte Farben an die Sockel angeschlossen werden — erst wenn alle Paare richtig verbunden sind, hat das Schiff wieder Energie."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

