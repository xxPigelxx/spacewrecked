[node name="Body" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Treibstoff/VBox" unique_id=1321132059]
layout_mode = 2
text = "Der Treibstoff des Schiffes ist eine empfindliche Mischung und darf aus Sicherheitsgründen nicht fertig gemischt gelagert werden. Wird der Vorrat knapp, muss er von Hand nach Rezept gemischt werden.  Während du eine Flüssigkeit in der Hand hast, nutze die rechte Maustaste, um sie gekonnt zu kippen. Ist zu viel davon im Behälter, halte die Q-Taste gedrückt, um sie wieder abzulassen."
fit_content = true
scroll_active = false
script = ExtResource("2_puywe")

