[node name="S1" type="RichTextLabel" parent="ManualRoot/PanelContainer/TabContainer/Schild/VBox/StepList" unique_id=427143907]
layout_mode = 2
text = "1.  Strom aktiv? Treibstoff gefuellt? Weiter."
