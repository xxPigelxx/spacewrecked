[node name="VBox" type="VBoxContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom" unique_id=704161348]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="PageTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox" unique_id=1305856558]
layout_mode = 2
text = "Sicherungskasten — Kabelverbindung"

[node name="Sep" type="HSeparator" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox" unique_id=2034622444]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox" unique_id=1091349098]
layout_mode = 2
text = "Der Kurzschluss hat alle Sicherungen ausgeloest. Im unteren Deck hinter der roten Tuer findest du den Hauptsicherungskasten. Verbinde nur gleiche Farben miteinander. Falsche Verbindungen koennen einen Folgebrand ausloesen. Benutze die Taschenlampe."
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox" unique_id=1660266208]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox/WarningBox" unique_id=208872154]
layout_mode = 2
text = "ACHTUNG: Niemals zwei verschiedene Farben verbinden!"
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox" unique_id=1159925433]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox" unique_id=1100314981]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox/StepList" unique_id=1622044138]
layout_mode = 2
text = "1.  Taschenlampe aufheben - Hauptraum neben der Luke."
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox/StepList" unique_id=185505505]
layout_mode = 2
text = "2.  Roten Gang - Luke am Ende mit E oeffnen."
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox/StepList" unique_id=652112137]
layout_mode = 2
text = "3.  Konsole mit E oeffnen."
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox/StepList" unique_id=220463226]
layout_mode = 2
text = "4.  ROT-ROT, BLAU-BLAU, GELB-GELB, GRUEN-GRUEN verbinden."
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Strom/VBox/StepList" unique_id=1547759667]
layout_mode = 2
text = "5.  Alle Paare korrekt - Strom kehrt zurueck."
script = ExtResource("2_puywe")

[node name="Page_Treibstoff" type="Control" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages" unique_id=1848747267]
