[node name="PageTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox" unique_id=1512499836]
layout_mode = 2
text = "Notfall-Handbuch — Bord-KI ASTRO"

[node name="Sep" type="HSeparator" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox" unique_id=515578057]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox" unique_id=1462620194]
layout_mode = 2
text = "Notfall-Protokoll Alpha-7 wurde aktiviert. Das Schiff hat beim Durchflug durch den Asteroidenguertel schwere Schaeden erlitten. Vier Systeme sind ausgefallen. Du musst sie in der richtigen Reihenfolge reparieren. Lies jeden Tab sorgfaeltig."
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox" unique_id=2020582586]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox/WarningBox" unique_id=1077706865]
layout_mode = 2
text = "WARNUNG: Systeme kritisch. Strom zuerst reparieren."
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox" unique_id=281292014]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox" unique_id=1333408660]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox/StepList" unique_id=929785744]
layout_mode = 2
text = "1.  Tab STROM oeffnen."
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox/StepList" unique_id=679338780]
layout_mode = 2
text = "2.  Sicherungskasten im unteren Deck finden."
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox/StepList" unique_id=1271666769]
layout_mode = 2
text = "3.  Kabel verbinden, Tab TREIBSTOFF, dann SCHILD."
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox/StepList" unique_id=1204363596]
layout_mode = 2
text = "4.  Zugangscode im Tab ZUGANG ablesen."
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Uebersicht/VBox/StepList" unique_id=1652612188]
layout_mode = 2
text = "5.  Schild aktivieren und starten."
script = ExtResource("2_puywe")

[node name="Page_Strom" type="Control" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages" unique_id=1244247663]
visible = false
anchors_preset = 0
