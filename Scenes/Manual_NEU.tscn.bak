[node name="VBox" type="VBoxContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff" unique_id=576080309]
layout_mode = 0
anchor_right = 1.0
anchor_bottom = 1.0

[node name="PageTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox" unique_id=1841907496]
layout_mode = 2
text = "Treibstoff-Mischung Typ-B Notverfahren"

[node name="Sep" type="HSeparator" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox" unique_id=1808285448]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox" unique_id=1916316927]
layout_mode = 2
text = "Das Triebwerk benoetigt fuer den Notstart einen Drei-Komponenten-Mix. Die Reihenfolge ist entscheidend. Lies die Mengen genau ab und bestatige jeden Schritt wenn die Kontrolllampe gruen leuchtet. Niemals Xenon vor Hydrazin einfuellen."
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox" unique_id=1667509458]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox/WarningBox" unique_id=1304953406]
layout_mode = 2
text = "KRITISCH: 3x HYDRAZIN - 2x XENON - 1x STABILISATOR TYP-7"
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox" unique_id=949895760]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox" unique_id=934929598]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox/StepList" unique_id=1751937445]
layout_mode = 2
text = "1.  Cockpit - linkes Panel - Treibstoffkonsole."
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox/StepList" unique_id=1954292097]
layout_mode = 2
text = "2.  3 Einheiten HYDRAZIN - bestaetigen."
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox/StepList" unique_id=425136773]
layout_mode = 2
text = "3.  Lampe gruen - 2 Einheiten XENON."
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox/StepList" unique_id=1331944117]
layout_mode = 2
text = "4.  Lampe gruen - 1 Einheit STABILISATOR TYP-7."
script = ExtResource("2_puywe")

[node name="S5" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Treibstoff/VBox/StepList" unique_id=361324337]
layout_mode = 2
text = "5.  Alle gruen - roter Startschalter druecken."
script = ExtResource("2_puywe")

