[node name="PageTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox" unique_id=1319242313]
layout_mode = 2
text = "Zugangscodes — Gesperrte Bereiche"

[node name="Sep" type="HSeparator" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox" unique_id=462556299]
layout_mode = 2

[node name="Body" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox" unique_id=69416848]
layout_mode = 2
text = "Nach dem Notfall wurden alle Sicherheitstueren verriegelt. Der vierstellige Entsperrcode fuer den Maschinenraum wurde geaendert. Der neue Zugangscode lautet: neun-sechs-zwei-vier. Bei drei Fehleingaben sperrt das System fuer sechzig Sekunden."
script = ExtResource("2_puywe")

[node name="WarningBox" type="PanelContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox" unique_id=1161668216]
layout_mode = 2

[node name="WarnLabel" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox/WarningBox" unique_id=209656578]
layout_mode = 2
text = "HINWEIS: Code steht im Text oben. Ziffern koennen vertauscht erscheinen."
script = ExtResource("2_puywe")

[node name="StepsTitle" type="Label" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox" unique_id=1799717854]
layout_mode = 2
text = "Schritte:"

[node name="StepList" type="VBoxContainer" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox" unique_id=1599914974]
layout_mode = 2

[node name="S1" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox/StepList" unique_id=104172358]
layout_mode = 2
text = "1.  Zum Numpad an der Maschinenraum-Tuer gehen."
script = ExtResource("2_puywe")

[node name="S2" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox/StepList" unique_id=1582969873]
layout_mode = 2
text = "2.  Code aus diesem Tab ablesen."
script = ExtResource("2_puywe")

[node name="S3" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox/StepList" unique_id=959154143]
layout_mode = 2
text = "3.  Code eingeben: 9 - 6 - 2 - 4"
script = ExtResource("2_puywe")

[node name="S4" type="RichTextLabel" parent="ManualRoot/PagePanel/MarginContainer/VBox/Pages/Page_Zugang/VBox/StepList" unique_id=1190802193]
layout_mode = 2
text = "4.  Tuer oeffnet sich automatisch."
script = ExtResource("2_puywe")

