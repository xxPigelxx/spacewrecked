[gd_resource type="Resource" script_class="PageConfig" format=3 uid="uid://bm6lmwa02wp8j"]

[ext_resource type="Script" uid="uid://cl4bpbly715ts" path="res://script/PageConfig.gd" id="1_jiwh6"]

[resource]
script = ExtResource("1_jiwh6")
page_id = "Einleitung"
section_label = "1.1"
page_title = "Willkommen an Bord"
raw_text = "Dieses Handbuch ist Ihr offizieller Begleiter an Bord. Es enthält alle Informationen, die Sie zur sicheren Bedienung Ihres Schiffes benötigen — von den Grundsystemen bis zu Notfallprozeduren. Lesen Sie jeden Abschnitt sorgfältig, bevor Sie ein System aktivieren. Unwissenheit schützt nicht vor den Folgen im Weltall."
steps = Array[String](["Öffnen Sie das Bord‑Handbuch über das Hauptmenü unter „System“ → „Manual“.\",    \"Wählen Sie im Inhaltsverzeichnis den gewünschten Abschnitt aus (z.B. Navigation, Schilde, Triebwerke", "Lesen Sie die jeweilige Seite sorgfältig, bevor Sie das entsprechende System aktivieren.", "Halten Sie das Handbuch während des ersten Flugs geöffnet, um die Bedienungsschritte einzuprägen.", "Melden Sie Fehler oder unklare Anweisungen über das interne Log‑Subsystem an die Bodenstation."])
enable_size_variation = true
enable_letter_swap = true
swap_chance = 0.6
enable_word_drift = true
drift_amplitude = 20.0
drift_frequency = 3.0
metadata/_custom_type_script = "uid://cl4bpbly715ts"
