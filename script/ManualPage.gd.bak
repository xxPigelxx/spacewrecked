# ManualPage.gd
# Sehr einfach — schaltet nur zwischen den Page-Nodes um.
# Alle Inhalte und DyslexiaLabel-Effekte direkt in der Scene einstellen.
#
# SCENE STRUKTUR:
#   ManualRoot (Control) — dieses Script
#   ├── SideButton (Button)
#   ├── PagePanel (PanelContainer)
#   │   ├── MarginContainer
#   │   │   └── VBox (VBoxContainer)
#   │   │       ├── TabBar (HBoxContainer)  ← Tabs auto-gebaut
#   │   │       ├── HSeparator
#   │   │       └── Pages (Control)         ← alle Seiten hier drin
#   │   │           ├── Page_Home (Control)
#   │   │           ├── Page_Strom (Control)
#   │   │           ├── Page_Treibstoff (Control)
#   │   │           ├── Page_Zugang (Control)
#   │   │           └── Page_Schild (Control)
#   └── Footer (HBoxContainer)
#       ├── PrevButton
#       └── NextButton

extends Control

# ── Nodes ─────────────────────────────────────────────────────────────────────

@onready var side_button : Button        = $SideButton
@onready var tab_bar     : HBoxContainer = $PagePanel/MarginContainer/VBox/TabBar
@onready var pages_root  : Control       = $PagePanel/MarginContainer/VBox/Pages
@onready var prev_btn    : Button        = $Footer/PrevButton
@onready var next_btn    : Button        = $Footer/NextButton

# ── State ─────────────────────────────────────────────────────────────────────

var _pages : Array[Control] = []   # alle Page_X Nodes
var _tabs  : Array[Button]  = []
var _cur   : int = 0
var _open  : bool = false

# ── Lifecycle ─────────────────────────────────────────────────────────────────

func _ready() -> void:
	position.x = get_viewport_rect().size.x

	# Alle Kinder von Pages als Seiten einsammeln
	for child in pages_root.get_children():
		if child is Control:
			_pages.append(child)

	_build_tabs()
	_show_page(0)

	side_button.toggled.connect(_on_side_toggled)
	prev_btn.pressed.connect(_on_prev)
	next_btn.pressed.connect(_on_next)

# ── Public ────────────────────────────────────────────────────────────────────

## Handbuch öffnen, optional auf einer Seite.
## Seitenname = Node-Name ohne "Page_", z.B. open("Strom")
func open(page_name: String = "") -> void:
	if page_name != "":
		for i in _pages.size():
			if _pages[i].name == "Page_" + page_name:
				_show_page(i)
				break
	if not _open:
		_slide_in()

## Stress setzen — alle DyslexiaLabels reagieren automatisch.
func set_stress(level: float) -> void:
	DyslexiaManager.stress = level

# ── Tabs ──────────────────────────────────────────────────────────────────────

func _build_tabs() -> void:
	for c in tab_bar.get_children():
		c.queue_free()
	_tabs.clear()

	for i in _pages.size():
		var b := Button.new()
		# Tab-Name = Node-Name ohne "Page_" Prefix
		b.text = _pages[i].name.trim_prefix("Page_")
		b.toggle_mode = true
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		var idx := i
		b.pressed.connect(func(): _show_page(idx))
		tab_bar.add_child(b)
		_tabs.append(b)

# ── Seite wechseln ────────────────────────────────────────────────────────────

func _show_page(index: int) -> void:
	_cur = clampi(index, 0, _pages.size() - 1)

	for i in _pages.size():
		_pages[i].visible = (i == _cur)

	for i in _tabs.size():
		_tabs[i].button_pressed = (i == _cur)

	prev_btn.disabled = (_cur == 0)
	next_btn.disabled = (_cur == _pages.size() - 1)

# ── Nav ───────────────────────────────────────────────────────────────────────

func _on_prev() -> void:
	_show_page(_cur - 1)

func _on_next() -> void:
	_show_page(_cur + 1)

# ── Slide ─────────────────────────────────────────────────────────────────────

func _slide_in() -> void:
	_open = true
	_tween_to(get_viewport_rect().size.x - size.x)
	side_button.button_pressed = true
	side_button.text = "Schliessen"

func _slide_out() -> void:
	_open = false
	_tween_to(get_viewport_rect().size.x)
	side_button.button_pressed = false
	side_button.text = "Handbuch"

func _tween_to(tx: float) -> void:
	var t := create_tween()
	t.tween_property(self, "position:x", tx, 0.4)\
		.set_trans(Tween.TRANS_BACK).set_ease(Tween.EASE_OUT)

func _on_side_toggled(on: bool) -> void:
	if on: _slide_in()
	else:  _slide_out()
