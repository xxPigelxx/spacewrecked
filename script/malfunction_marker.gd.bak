extends Interactable
class_name MalfunctionMarker

## Ein Interactable, das nur aufleuchtet, wenn GameLoop eine passende Aufgabe startet.
## Spieler muss hinlaufen und es aktivieren, um das Puzzle zu öffnen.
## marker_id muss mit dem marker_id-Feld in GameLoop.task_sequence übereinstimmen.

@export var marker_id: String = "cable"

var _active := false
var _current_task: Dictionary = {}

func _setup() -> void:
	# Standardmäßig versteckt/inaktiv
	visible = false
	_set_collision_active(false)
	GameLoop.task_started.connect(_on_task_started)
	GameLoop.task_completed.connect(_on_task_completed)
	GameLoop.phase_changed.connect(_on_phase_changed)

func _on_task_started(_index: int, task: Dictionary) -> void:
	if task.get("marker_id", "") != marker_id:
		return
	_current_task = task
	_active = true
	visible = true
	_set_collision_active(true)

func _on_task_completed(_index: int, task: Dictionary, _t: float) -> void:
	if task.get("marker_id", "") != marker_id:
		return
	_deactivate()

func _on_phase_changed(phase: int) -> void:
	# Beim Ende der Journey alles ausblenden
	if phase != GameLoop.Phase.JOURNEY:
		_deactivate()

func _deactivate() -> void:
	_active = false
	visible = false
	_set_collision_active(false)
	if label:
		label.visible = false

## Nur reagieren, wenn aktiv; öffnet das zugehörige Puzzle als Overlay.
func _action() -> void:
	if not _active:
		return
	SceneSwitcher.open_overlay_with_data(
		_current_task.get("scene", ""),
		_current_task.get("data", {}),
		true, false
	)

func _set_collision_active(on: bool) -> void:
	# Interaktion nur möglich, wenn aktiv
	set_deferred("monitoring", on)
	set_deferred("monitorable", on)
