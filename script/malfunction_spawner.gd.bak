extends Node2D
class_name MalfunctionSpawner

## Hält die Störungs-Interactables als Kinder (feste Reihenfolge = Kind-Reihenfolge).
## GameState steuert über die Kurve, wie viele JETZT aktiv sein sollen;
## der Spawner aktiviert die nächsten ungenutzten Kinder bis zu diesem Ziel.
## Mehrere können gleichzeitig aktiv sein — der Spieler wählt, welche er repariert.
##
## Jedes Kind sollte ein MalfunctionInteractable sein (zeigt/versteckt sich,
## öffnet sein Puzzle bei Aktivierung, meldet Lösung an GameState).

var _children: Array[Node] = []
var _next_index := 0          ## nächstes noch nie aktiviertes Kind
var _target := 0              ## gewünschte Anzahl aktiver Störungen
var _in_progress: Node = null ## Störung, deren Puzzle gerade offen ist

func _ready() -> void:
	GameState.register_spawner(self)
	for c in get_children():
		_children.append(c)
		if c.has_method("deactivate"):
			c.deactivate()

## Journey-Start: Zustand zurücksetzen.
func begin() -> void:
	_next_index = 0
	_target = 0
	for c in _children:
		if c.has_method("deactivate"):
			c.deactivate()

## Von GameState pro Frame aufgerufen: bis auf 'target' aktive auffüllen.
func update_target(target: int) -> void:
	_target = max(0, target)
	while active_unsolved_count() < _target and _next_index < _children.size():
		var c: Node = _children[_next_index]
		_next_index += 1
		if c.has_method("activate"):
			c.activate()

## Anzahl gerade aktiver, ungelöster Störungen.
func active_unsolved_count() -> int:
	var n := 0
	for c in _children:
		if c.has_method("is_active_unsolved") and c.is_active_unsolved():
			n += 1
	return n

## Alles ausblenden (Journey-Ende).
func clear_all() -> void:
	_in_progress = null
	for c in _children:
		if c.has_method("deactivate"):
			c.deactivate()

## Vom Kind aufgerufen, wenn der Spieler dessen Puzzle öffnet.
func set_in_progress(child: Node) -> void:
	_in_progress = child

## Von GameState aufgerufen, wenn ein Puzzle gelöst wurde.
func resolve_in_progress() -> void:
	if _in_progress and _in_progress.has_method("mark_solved"):
		_in_progress.mark_solved()
	_in_progress = null
